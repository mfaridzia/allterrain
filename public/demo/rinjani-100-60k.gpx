<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="COROS Athletic Platform" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Rinjani 100 - 60K Official Ultra Course (Demo)</name>
    <desc>Official GPX course for Rinjani 100 Ultra Trail 60K. Total Distance: 60.5 km, Elevation Gain: +5,350m D+, COT: 20 Jam.</desc>
  </metadata>
  <wpt lat="-8.3582" lon="116.5298">
    <ele>1156</ele>
    <name>Start Sembalun</name>
    <desc>Start race Sembalun 1.156 mdpl. Suhu sejuk, jalur savana datar. [COT 00:00]</desc>
  </wpt>
  <wpt lat="-8.375" lon="116.495">
    <ele>1500</ele>
    <name>WS 1 (Pos 2 Tengengean)</name>
    <desc>Pos air pertama. Jalur mulai menanjak melewati savana. [COT 02:15]</desc>
  </wpt>
  <wpt lat="-8.398" lon="116.468">
    <ele>2639</ele>
    <name>WS 2 (Plawangan Sembalun)</name>
    <desc>Batas bibir kaldera Rinjani. Angin kencang, persiapan jaket windbreaker sebelum summit push. [COT 05:45]</desc>
  </wpt>
  <wpt lat="-8.4113" lon="116.4573">
    <ele>3726</ele>
    <name>Puncak Rinjani (Summit 3.726m)</name>
    <desc>Titik tertinggi 3.726 mdpl! Medan pasir vulkanik letter E, suhu bisa mencapai 4°C. [COT 08:30]</desc>
  </wpt>
  <wpt lat="-8.405" lon="116.425">
    <ele>2004</ele>
    <name>WS 3 (Danau Segara Anak)</name>
    <desc>Turunan terjal bebatuan ke kaldera danau vulkanik. Rehidrasi air melimpah dan isi karbohidrat. [COT 12:00]</desc>
  </wpt>
  <wpt lat="-8.375" lon="116.405">
    <ele>2641</ele>
    <name>WS 4 (Plawangan Senaru)</name>
    <desc>Tanjakan kedua keluar dari danau menuju bibir kaldera Senaru. Medan batu curam berpasak. [COT 15:00]</desc>
  </wpt>
  <wpt lat="-8.335" lon="116.408">
    <ele>1500</ele>
    <name>WS 5 (Pos 2 Senaru Montong Satas)</name>
    <desc>Masuk hutan hujan tropis lebat. Jalur tanah dan akar pohon basah licin. Waspada saat gelap. [COT 18:00]</desc>
  </wpt>
  <wpt lat="-8.305" lon="116.411">
    <ele>601</ele>
    <name>Finish Gate Senaru</name>
    <desc>Garis akhir finish Senaru! COT Resmi 20 Jam selesai. [COT 20:00]</desc>
  </wpt>
  <trk>
    <name>Rinjani 100 - 60K Course</name>
